# ============ JWT CONFIGURATION (RS256) ============
# RS256 uses RSA keys (asymmetric encryption)
# For production: Set these environment variables with your RSA keys

# Private key for signing JWTs (keep this SECURE!)
# Generated by: python generate_rsa_keys.py
# Store the contents of private.pem here (paste the entire key including BEGIN/END markers)
JWT_PRIVATE_KEY=

# Public key for verifying JWTs (can be shared)
# Store the contents of public.pem here (paste the entire key including BEGIN/END markers)
JWT_PUBLIC_KEY=

# ============ DATABASE CONFIGURATION ============
DATABASE_URL=

# ============ EMAIL CONFIGURATION ============
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============ SUPABASE CONFIGURATION ============
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# ============ SECRET KEY ============
# Used for session middleware
SECRET_KEY=
